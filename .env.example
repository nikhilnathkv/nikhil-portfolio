# =============================================================================
# nikhil-portfolio — environment configuration
# Copy this file to `.env` and adjust values for your local setup.
#   cp .env.example .env
# The `.env` file is git-ignored and read by docker-compose and both apps.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# SQLAlchemy connection string (async driver).
# Host is `postgres` inside docker-compose, `localhost` when running the API
# directly on the host machine.
DATABASE_URL=postgresql+asyncpg://portfolio:portfolio@postgres:5432/portfolio

# -----------------------------------------------------------------------------
# API (FastAPI)
# -----------------------------------------------------------------------------
API_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info

# Comma-separated list of allowed CORS origins for the public web app.
CORS_ORIGINS=http://localhost:3000

# Secret used to sign session cookies. Generate a strong value for anything
# beyond local development, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SESSION_SECRET=change-me-in-production

# Auth session cookie. SESSION_SECURE must be true in production (HTTPS); it is
# forced on automatically when API_ENV=production.
SESSION_COOKIE_NAME=portfolio_session
SESSION_SECURE=false
SESSION_SAMESITE=lax
SESSION_MAX_AGE_DAYS=14

# Login brute-force protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# Object storage (MinIO / S3-compatible) for media + resume uploads
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=portfolio
MINIO_SECRET_KEY=portfolio123
MINIO_BUCKET=media
MINIO_SECURE=false
# Public base URL browsers use to load assets (a CDN in production)
MINIO_PUBLIC_URL=http://localhost:9000
MAX_UPLOAD_MB=10

# Basic contact-form throttle (per IP)
CONTACT_MAX_PER_WINDOW=5
CONTACT_WINDOW_SECONDS=3600

# -----------------------------------------------------------------------------
# Web (Next.js)
# -----------------------------------------------------------------------------
# Base URL the browser uses to reach the API. Must be public (NEXT_PUBLIC_*).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Base URL used for server-side requests (RSC/route handlers). In docker-compose
# this is the internal service; in the managed split it is the API's public URL.
API_INTERNAL_URL=http://api:8000/api/v1

# Public origin browsers load uploaded media from (MinIO locally; a CDN / R2 /
# S3 public URL in production). Also whitelisted in the web CSP + next/image.
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000

# Canonical public origin of the site (no trailing slash). Drives canonical
# URLs, OpenGraph URLs, sitemap.xml and robots.txt. Set to https://yourdomain.com
# in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics: cookieless + OFF by default. Leave blank to disable entirely.
# Set to `plausible` or `umami` in production to enable the pluggable track().
NEXT_PUBLIC_ANALYTICS_PROVIDER=

# =============================================================================
# Production notes (managed split: Vercel web · Fly/Railway/Render api ·
# managed Postgres (Neon/Supabase) · object storage (Cloudflare R2 / S3))
# -----------------------------------------------------------------------------
# API_ENV=production                     # forces Secure cookies + disables /docs
# DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST/DB   # managed Postgres (TLS)
# SESSION_SECRET=<64+ random chars>      # python -c "import secrets;print(secrets.token_urlsafe(48))"
# SESSION_SECURE=true                    # (auto-on when API_ENV=production)
# CORS_ORIGINS=https://yourdomain.com    # exact public web origin(s), never *
# MINIO_ENDPOINT=<r2/s3 endpoint host>   # e.g. <acct>.r2.cloudflarestorage.com
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY    # storage credentials (rotate; never commit)
# MINIO_BUCKET=media  MINIO_SECURE=true
# MINIO_PUBLIC_URL=https://cdn.yourdomain.com   # public/CDN base for assets
# Web (Vercel project env):
#   NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
#   API_INTERNAL_URL=https://api.yourdomain.com/api/v1
#   NEXT_PUBLIC_MEDIA_URL=https://cdn.yourdomain.com
#   NEXT_PUBLIC_SITE_URL=https://yourdomain.com
#   NEXT_PUBLIC_ANALYTICS_PROVIDER=plausible
